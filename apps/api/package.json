{
    "name":  "@autopilot/api",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description": "Trustlane commerce orchestration API (Fastify).",
    "scripts":  {
                    "dev":  "node --watch --no-warnings=ExperimentalWarning src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "openapi":  "node dist/scripts/emit-openapi.js",
                    "postman:emit":  "node dist/scripts/emit-postman.js",
                    "seed":  "node dist/scripts/seed.js",
                    "postman:run":  "npm run run -w @autopilot/postman"
                },
    "dependencies":  {
                         "@autopilot/agent-tools":  "*",
                         "@autopilot/apimatic":  "*",
                         "@autopilot/astropods":  "*",
                         "@autopilot/channel3":  "*",
                         "@autopilot/elastic":  "*",
                         "@autopilot/kernel":  "*",
                         "@autopilot/paypal":  "*",
                         "@autopilot/persistence":  "*",
                         "@autopilot/policy-engine":  "*",
                         "@autopilot/postman":  "*",
                         "@autopilot/schemas":  "*",
                         "@autopilot/zapier":  "*",
                         "@fastify/cors":  "^11.3.0",
                         "fastify":  "^5.12.5",
                         "zod":  "^4.6.5"
                     },
    "devDependencies":  {

                        }
}