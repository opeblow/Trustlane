# ---------------------------------------------------------------------------
# Autopilot — environment configuration
# Copy to .env and fill in what you have. NEVER commit .env.
# Every integration below degrades honestly: if a credential is missing the
# provider reports `unavailable` (or a documented local substitute) instead of
# pretending to be live. See docs/limitations.md.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
# Public base URL of the API (used for OpenAPI server block + webhook callbacks)
API_PUBLIC_URL=http://127.0.0.1:4000
# Absolute path or :memory: for the SQLite database file
DATABASE_PATH=./data/autopilot.sqlite
# Comma separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Web (Next.js) -------------------------------------------------------
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# --- PayPal (core payment boundary) --------------------------------------
# Sandbox credentials: https://developer.paypal.com/dashboard/applications/sandbox
# Leave blank to run the deterministic offline provider (clearly labelled
# SIMULATED in the UI and audit trail). Never expose these to the browser.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Channel3 (product discovery) ----------------------------------------
# Not publicly available without a hackathon grant. Leave blank to use the
# bundled, clearly-labelled local catalog source (LOCAL_CATALOG).
CHANNEL3_BASE_URL=
CHANNEL3_API_KEY=
CHANNEL3_TIMEOUT_MS=8000

# --- Elastic (audit search) ----------------------------------------------
# Leave blank to use the built-in local index (same interface, no server).
ELASTIC_NODE=
ELASTIC_API_KEY=
ELASTIC_INDEX=autopilot-events

# --- Zapier (post-purchase automation) -----------------------------------
# A real "Catch Hook" from your Zap. Leave blank and automations are recorded
# as `unconfigured` (purchase stays verified, automation marked pending).
ZAPIER_HOOK_URL=

# --- LLM (optional AI interpreter) ---------------------------------------
# The agent ships a deterministic interpreter/scoring core that always works.
# Set a key to additionally use an LLM for intent parsing and explanations;
# every tool call stays schema-validated and policy-gated, and the UI shows
# which engine produced each result.
LLM_PROVIDER=none            # none | openai | anthropic | gemini
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Astropods (optional agent tracing export) ---------------------------
ASTROPODS_ENDPOINT=
ASTROPODS_API_KEY=

# --- KERNEL (optional intelligence/security capability) -------------------
KERNEL_BASE_URL=
KERNEL_API_KEY=

# --- Bryntum (commercial timeline/grid) ----------------------------------
# Without a license the Bryntum components are not loaded; the built-in
# timeline renders from the same execution events. See docs/sponsor-map.md
NEXT_PUBLIC_BRYNTUM_LICENSE=
NEXT_PUBLIC_BRYNTUM_VERSION=7.3.7